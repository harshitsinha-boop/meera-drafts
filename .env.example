# Telegram - token from @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string (openssl rand -hex 24). Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Meera's numeric user id - message the bot /start to get it
TELEGRAM_OWNER_ID=
# The notes channel id (starts with -100) - forward a channel post to the bot to get it
TELEGRAM_CHANNEL_ID=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional, defaults to gemini-3.6-flash
# GEMINI_MODEL=

# Any long random string. Vercel Cron sends it; the app also uses it to start draft jobs
CRON_SECRET=

# Set automatically on Vercel when you connect a Blob store (Storage tab).
# Leave unset locally: notes are then kept in ./.data
# BLOB_READ_WRITE_TOKEN=

# Optional: drafts per scheduled run (1-3). Runs Mon/Wed/Fri, so 1 = three posts a week
# DRAFTS_PER_RUN=1
